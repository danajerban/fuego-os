<?xml version="1.0" encoding="utf-8"?>
<!-- The clock: the time, a hairline and the date, as on a lock screen; see ClockView.kt. -->
<io.github.danajerban.fuegoos.ClockView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:id="@+id/clock_time"
        style="@style/ClockText"
        android:textSize="@dimen/clock_time_text" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/clock_hairline"
        android:background="@drawable/clock_hairline" />

    <TextView
        android:id="@+id/clock_date"
        style="@style/ClockText"
        android:textSize="@dimen/clock_date_text" />
</io.github.danajerban.fuegoos.ClockView>
