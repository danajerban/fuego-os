<?xml version="1.0" encoding="utf-8"?>
<!-- A Dock tile: a clear glass pane, lit a little from the top and edged with light so it reads as glass
     over the artwork. The focused tile is shown by the floating glass highlight (GlassHighlight). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="@dimen/dock_tile_corner" />
    <gradient
        android:angle="270"
        android:endColor="#03FFFFFF"
        android:startColor="#17FFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
</shape>
