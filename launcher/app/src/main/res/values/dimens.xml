<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="dock_margin_bottom">64dp</dimen>
    <!-- Room around the tiles for a focused tile's 10% scale-up and the highlight's glow. -->
    <dimen name="dock_band_padding">18dp</dimen>
    <dimen name="dock_band_corner">28dp</dimen>
    <!-- Six tiles with their gaps and the band's padding come to 876dp: inside the TV's 960dp screen
         (1280x720 at density 213) with 42dp to spare on each side. -->
    <dimen name="dock_tile_width">128dp</dimen>
    <dimen name="dock_tile_height">90dp</dimen>
    <dimen name="dock_tile_gap">6dp</dimen>
    <dimen name="dock_tile_corner">12dp</dimen>
    <dimen name="dock_tile_text">20sp</dimen>
    <!-- A tile's icon sits above its label. The padding centres the two together in the tile and leaves
         the label's line, centred below the icon, room for its descenders. -->
    <dimen name="dock_tile_icon">36dp</dimen>
    <dimen name="dock_tile_icon_gap">6dp</dimen>
    <dimen name="dock_tile_padding_top">10dp</dimen>
    <dimen name="dock_tile_padding_bottom">6dp</dimen>
    <!-- The focus highlight is a tile plus its glow on every side. -->
    <dimen name="focus_glass_glow">6dp</dimen>
    <dimen name="focus_glass_width">140dp</dimen>
    <dimen name="focus_glass_height">102dp</dimen>

    <!-- The clock, as on Home; the Idle Screen shows it larger (IdleScreen.kt). -->
    <dimen name="clock_time_text">84sp</dimen>
    <dimen name="clock_date_text">22sp</dimen>
    <dimen name="clock_hairline">1dp</dimen>
    <!-- Room around the time and date for their shadow; also the space between them and the hairline. -->
    <dimen name="clock_text_padding">8dp</dimen>
    <!-- On Home, the clock sits about the optical centre of the space above the Dock. -->
    <dimen name="clock_margin_top">76dp</dimen>
    <!-- How far from its laid-out place the Idle Screen's clock drifts, against burn-in. -->
    <dimen name="clock_drift">10dp</dimen>
</resources>
