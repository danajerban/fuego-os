#!/bin/bash
# The fake TV: stands in for adb in the script's tests (FUEGO_ADB points here).
#
# It answers the adb calls the script makes the way a real TV does, holding the TV's state as
# plain files in $FAKE_TV (made by fake_tv_new in lib.sh):
#
#   packages/<package>     "<state> <kind>": state enabled|disabled-user|disabled, kind system|user
#   home-activities        "<component> <priority>" for each activity that answers the Home intent.
#                          Home opens the enabled one with the highest priority; the chosen one
#                          wins only among equals, and two equals with none chosen give the chooser
#   home                   the Home activity set with set-home-activity (absent: none chosen)
#   focus                  the focused activity, or "null"
#   settings/<ns>/<key>    settings values (ns: global, secure, system)
#   props/<name>           getprop values
#   meminfo                "<MemTotal kB> <MemAvailable kB>"
#   storage                /data as "<1K-blocks> <used> <available>"
#   activities             the exported activities besides Home that installed apps bring (the
#                          Launcher's Inputs screen), one component per line (absent: none)
#   home-draw-ms           how long Home takes to draw when started, or brought back from one of
#                          those activities
#   processes/<package>    a running package's TOTAL PSS in kB (dumpsys meminfo)
#   sdcard/                files under /sdcard (also reachable as /storage/emulated/0)
#   versions/<package>     "<versionName> <versionCode> <key>" of an app installed with adb install
#                          (absent: "1.0 1 release")
#   app-folders/<package>  the folders an installed app makes under /sdcard/Android/data/<package>/
#                          when it starts, one per line (from the fake APK's "folder=" lines)
#   link/                  pairing and connection: pair-address, pairing-code, address,
#                          paired (present once paired), connected (connected addresses),
#                          mdns (absent: none): the name adb's mDNS also lists the TV under,
#                          connected or not; `adb devices` lists it after the connected addresses
#   faults/                misbehaviour, see fake_tv_fault in lib.sh
#   calls                  every call, one per line: "read ARGS", "write ARGS" or "unsupported ARGS"
#                          (ARGS without a leading "-s SERIAL")
#
# Like adb, a call to the TV with several devices listed needs -s SERIAL, and -s names a listed
# device, or the call fails with adb's error.
#
# The script runs one plain command per `adb shell` (no pipes, quotes or redirects on the TV)
# and filters output on the Mac, so the fake only needs to know each command, not a shell.
# A call the fake doesn't know fails with exit status 64: teach it the call here, answering
# exactly as a real TV does, and add a test for it in fake-tv.test.sh.
#
# FAKE_TV_INSPECT=1 lets tests read state through the fake without logging or faults.

set -u
tv=${FAKE_TV:?FAKE_TV must point at a fake TV made by fake_tv_new}

inspecting() { [ -n "${FAKE_TV_INSPECT-}" ]; }
fault() { ! inspecting && [ -e "$tv/faults/$1" ]; }

# A write to a target listed in faults/ignore-writes answers as usual but changes nothing.
ignored() {
  [ -f "$tv/faults/ignore-writes" ] && grep -qxF "$1" "$tv/faults/ignore-writes"
}

# faults/offline-after: the TV leaves the network right after the write call it names.
after_write() {
  [ -f "$tv/faults/offline-after" ] || return 0
  case "$call" in
    *"$(cat "$tv/faults/offline-after")"*)
      : > "$tv/faults/offline"
      rm -f "$tv/faults/offline-after"
      ;;
  esac
}

die() {
  printf '%s\n' "$1" >&2
  exit "${2:-1}"
}

# --- The link between the Mac and the TV -----------------------------------------------------

# listed: the serials `adb devices` lists, one per line: the connected addresses, then the mDNS
# name. Wireless debugging off lists none.
listed() {
  fault debugging-off && return 0
  cat "$tv/link/connected"
  [ ! -f "$tv/link/mdns" ] || cat "$tv/link/mdns"
}

need_device() {
  local serials
  inspecting && return 0
  fault offline && die "error: device offline"
  serials=$(listed)
  [ -n "$serials" ] || die "error: no devices/emulators found"
  if [ -n "$serial" ]; then
    printf '%s\n' "$serials" | grep -qxF "$serial" || device_error "device '$serial' not found"
  elif [ "$(printf '%s\n' "$serials" | wc -l)" -gt 1 ]; then
    device_error "more than one device/emulator"
  fi
}

# device_error MESSAGE: adb's answer when it can't pick the device, worded by the command.
device_error() {
  case "$command" in
    get-state) die "error: $1" ;;
    push) die "adb: error: failed to get feature set: $1" ;;
    *) die "adb: $1" ;;
  esac
}

pair() {
  local address=${1-} code=${2-}
  if fault offline || fault debugging-off || [ "$address" != "$(cat "$tv/link/pair-address")" ]; then
    die "Failed: Unable to start pairing client."
  fi
  [ "$code" = "$(cat "$tv/link/pairing-code")" ] ||
    die "Failed: Wrong password or connection was dropped."
  : > "$tv/link/paired"
  echo "Successfully paired to $address [guid=adb-GoogleTV8164-fake]"
}

# adb connect prints its failures on stdout and exits 0, so the script must read the output.
connect() {
  local address=${1-}
  if fault offline; then
    echo "failed to connect to '$address': Operation timed out"
  elif fault debugging-off || [ "$address" != "$(cat "$tv/link/address")" ]; then
    echo "failed to connect to '$address': Connection refused"
  elif [ ! -e "$tv/link/paired" ]; then
    echo "failed to authenticate to $address"
  elif grep -qxF "$address" "$tv/link/connected"; then
    echo "already connected to $address"
  else
    echo "$address" >> "$tv/link/connected"
    echo "connected to $address"
  fi
}

disconnect() {
  : > "$tv/link/connected"
  echo "disconnected ${1-everything}"
}

devices() {
  local address
  echo "List of devices attached"
  listed | while read -r address; do
    if fault offline; then printf '%s\toffline\n' "$address"; else printf '%s\tdevice\n' "$address"; fi
  done
  echo
}

# --- Packages ----------------------------------------------------------------------------

package_state() {
  local state kind
  read -r state kind < "$tv/packages/$1"
  echo "$state"
}

package_enabled() {
  [ -f "$tv/packages/$1" ] && [ "$(package_state "$1")" = enabled ]
}

list_packages() {
  local only_disabled="" flag file pkg state
  for flag in "$@"; do
    case "$flag" in
      -d) only_disabled=1 ;;
      *) unsupported ;;
    esac
  done
  for file in "$tv"/packages/*; do
    pkg=${file##*/}
    read -r state _ < "$file"
    [ -n "$only_disabled" ] && [ "$state" = enabled ] && continue
    echo "package:$pkg"
  done
}

set_package_state() {
  local command=$1 pkg=$2 new=$3 state kind
  if [ ! -f "$tv/packages/$pkg" ]; then
    {
      echo
      echo "Exception occurred while executing '$command':"
      echo "java.lang.IllegalArgumentException: Unknown package: $pkg"
      printf '\tat com.android.server.pm.PackageManagerService.setEnabledSettings(PackageManagerService.java:3904)\n'
    } >&2
    exit 255
  fi
  if ! ignored "$pkg"; then
    read -r state kind < "$tv/packages/$pkg"
    printf '%s %s\n' "$new" "$kind" > "$tv/packages/$pkg"
    # Disabling a package stops it.
    [ "$new" = enabled ] || stop_package "$pkg"
  fi
  echo "Package $pkg new state: $new"
}

# stop_package PACKAGE: the package stops running, and its activity loses focus.
stop_package() {
  rm -f "$tv/processes/$1"
  case "$(cat "$tv/focus")" in "$1"/*) echo null > "$tv/focus" ;; esac
}

# The fake APK is a text file: "package=<id>", any number of "home=<component>" lines, any
# number of "folder=<path>" lines (the folders the app makes under /sdcard/Android/data/<id>/
# when it starts, as getExternalFilesDir does), and optionally "version=<versionName>
# <versionCode>" (default "1.0 1") and "key=<signing key name>" (default "release"). An installed
# app's Home activities get priority 0: Android ignores priority for them.
# Replacing an installed app (install -r) refuses a lower versionCode, then another signing key,
# with Android's messages; a replace keeps the app's state and Home choice, and stops the old app.
install() {
  local apk="" pkg home version key was_code was_key
  for arg in "$@"; do
    case "$arg" in -*) ;; *) apk=$arg ;; esac
  done
  if [ ! -f "$apk" ]; then
    echo "Performing Streamed Install"
    die "adb: failed to stat $apk: No such file or directory"
  fi
  pkg=$(sed -n 's/^package=//p' "$apk")
  if [ -z "$pkg" ]; then
    echo "Performing Incremental Install"
    echo "Performing Streamed Install"
    die "adb: failed to install $apk: Failure [INSTALL_PARSE_FAILED_NOT_APK: Failed to parse /data/app/vmdl2012248553.tmp/base.apk: Failed to load asset path /data/app/vmdl2012248553.tmp/base.apk]"
  fi
  version=$(sed -n 's/^version=//p' "$apk")
  key=$(sed -n 's/^key=//p' "$apk")
  [ -n "$version" ] || version="1.0 1"
  [ -n "$key" ] || key=release
  echo "Performing Streamed Install"
  if [ -f "$tv/packages/$pkg" ]; then
    read -r _ was_code was_key <<< "$(package_version "$pkg")"
    if [ "${version#* }" -lt "$was_code" ]; then
      install_failed "$apk" "INSTALL_FAILED_VERSION_DOWNGRADE: Downgrade detected: Update version code ${version#* } is older than current $was_code"
    elif [ "$key" != "$was_key" ]; then
      install_failed "$apk" "INSTALL_FAILED_UPDATE_INCOMPATIBLE: Existing package $pkg signatures do not match newer version; ignoring!"
    fi
  fi
  if ! ignored "$pkg"; then
    if [ -f "$tv/packages/$pkg" ]; then
      stop_package "$pkg"
    else
      printf 'enabled user\n' > "$tv/packages/$pkg"
    fi
    mkdir -p "$tv/versions"
    printf '%s %s\n' "$version" "$key" > "$tv/versions/$pkg"
    sed -n 's/^home=//p' "$apk" | while read -r home; do
      home_candidate "$home" > /dev/null || echo "$home 0" >> "$tv/home-activities"
    done
    sed -n 's/^activity=//p' "$apk" | while read -r activity; do
      other_activity "$activity" || echo "$activity" >> "$tv/activities"
    done
    mkdir -p "$tv/app-folders"
    sed -n 's/^folder=//p' "$apk" > "$tv/app-folders/$pkg"
  fi
  echo "Success"
}

# install_failed APK REASON: adb's answer to an install the TV refused, ending in a blank line.
install_failed() {
  printf 'adb: failed to install %s: Failure [%s]\n\n' "$1" "$2" >&2
  exit 1
}

# package_version PACKAGE: "<versionName> <versionCode> <key>" of an installed package; packages
# the fake TV starts with have version 1.0 (1), signed with "release".
package_version() {
  if [ -f "$tv/versions/$1" ]; then cat "$tv/versions/$1"; else echo "1.0 1 release"; fi
}

# dumpsys package PACKAGE: the package's block, as API 34 prints it (shortened to the lines
# around its version).
dumpsys_package() {
  local name code
  if [ ! -f "$tv/packages/$1" ]; then
    echo "Unable to find package: $1"
    return 0
  fi
  read -r name code _ <<< "$(package_version "$1")"
  echo "Packages:"
  echo "  Package [$1] (aa944d1):"
  echo "    appId=10122"
  echo "    versionCode=$code minSdk=34 targetSdk=34"
  echo "    minExtensionVersions=[]"
  echo "    versionName=$name"
  echo "    usesNonSdkApi=false"
}

uninstall() {
  local pkg=${1-}
  [ -f "$tv/packages/$pkg" ] || die "Failure [DELETE_FAILED_INTERNAL_ERROR]"
  if ! ignored "$pkg"; then
    stop_package "$pkg"
    rm -f "$tv/packages/$pkg" "$tv/app-folders/$pkg" "$tv/versions/$pkg"
    rm -rf "$tv/sdcard/Android/data/$pkg"
    grep -v "^$pkg/" "$tv/home-activities" > "$tv/home-activities.new"
    mv "$tv/home-activities.new" "$tv/home-activities"
    if [ -f "$tv/activities" ]; then
      grep -v "^$pkg/" "$tv/activities" > "$tv/activities.new"
      mv "$tv/activities.new" "$tv/activities"
    fi
  fi
  echo "Success"
}

# --- Home and focus ----------------------------------------------------------------------

# Components print as "package/.Class" (short) or "package/package.Class" (long).
long_form() {
  local pkg=${1%%/*} class=${1#*/}
  case "$class" in .*) class=$pkg$class ;; esac
  echo "$pkg/$class"
}

short_form() {
  local pkg=${1%%/*} class=${1#*/}
  case "$class" in "$pkg".*) class=${class#"$pkg"} ;; esac
  echo "$pkg/$class"
}

# home_candidate COMPONENT: the priority of COMPONENT when it answers the Home intent.
home_candidate() {
  local want component priority
  want=$(long_form "$1")
  while read -r component priority; do
    if [ "$(long_form "$component")" = "$want" ]; then
      echo "$priority"
      return 0
    fi
  done < "$tv/home-activities"
  return 1
}

# other_activity COMPONENT: succeeds when COMPONENT is an exported activity besides Home.
other_activity() {
  local want component
  [ -f "$tv/activities" ] || return 1
  want=$(long_form "$1")
  while read -r component; do
    [ "$(long_form "$component")" = "$want" ] && return 0
  done < "$tv/activities"
  return 1
}

# resolve_home: "<priority> <component>" for the activity the Home button opens now.
resolve_home() {
  local chosen top="" component priority first="" count=0
  chosen=$(cat "$tv/home" 2> /dev/null)
  while read -r component priority; do
    package_enabled "${component%%/*}" || continue
    if [ -z "$top" ] || [ "$priority" -gt "$top" ]; then top=$priority; fi
  done < "$tv/home-activities"
  [ -n "$top" ] || return 1
  while read -r component priority; do
    package_enabled "${component%%/*}" && [ "$priority" = "$top" ] || continue
    if [ -n "$chosen" ] && [ "$(long_form "$component")" = "$(long_form "$chosen")" ]; then
      echo "$top $(short_form "$component")"
      return 0
    fi
    count=$((count + 1))
    [ -n "$first" ] || first=$component
  done < "$tv/home-activities"
  if [ "$count" -eq 1 ]; then
    echo "$top $(short_form "$first")"
  else
    echo "0 android/com.android.internal.app.ResolverActivity"
  fi
}

resolve_activity() {
  case " $* " in
    *" android.intent.category.HOME "*) ;;
    *) unsupported ;;
  esac
  local home
  home=$(resolve_home) || { echo "No activity found"; return 0; }
  echo "priority=${home%% *} preferredOrder=0 match=0x108000 specificIndex=-1 isDefault=true"
  echo "${home#* }"
}

# Any installed and enabled package is accepted, whatever the activity; only Home presses show
# whether the choice took.
set_home_activity() {
  local component=""
  for arg in "$@"; do
    case "$arg" in --user|0) ;; *) component=$arg ;; esac
  done
  package_enabled "${component%%/*}" || die "Error: Failed to set default home."
  ignored home || echo "$component" > "$tv/home"
  echo "Success"
}

# The HOME role: the package chosen with set-home-activity while it is installed, otherwise the
# package Home opens.
role_holders() {
  [ "$*" = "--user 0 android.app.role.HOME" ] || unsupported
  local chosen home
  chosen=$(cat "$tv/home" 2> /dev/null)
  if [ -n "$chosen" ] && [ -f "$tv/packages/${chosen%%/*}" ]; then
    echo "${chosen%%/*}"
  elif home=$(resolve_home); then
    home=${home#* }
    echo "${home%%/*}"
  fi
}

keyevent() {
  case "${1-}" in
    KEYCODE_HOME | 3)
      local home
      if ! ignored focus && home=$(resolve_home); then
        home=${home#* }
        echo "$home" > "$tv/focus"
        start_app "${home%%/*}"
      fi
      ;;
  esac
}

# start_app PACKAGE: the app runs, and makes its folders under /sdcard/Android/data/PACKAGE/.
start_app() {
  local folder
  [ -f "$tv/app-folders/$1" ] || return 0
  while read -r folder; do
    mkdir -p "$tv/sdcard/Android/data/$1/$folder"
  done < "$tv/app-folders/$1"
}

# As on API 34, the focus lines are in the displays section, not in the window list. The focused
# window names its activity in long form, the focused app in short form.
dumpsys_window_windows() {
  local focus
  focus=$(cat "$tv/focus")
  echo "WINDOW MANAGER WINDOWS (dumpsys window windows)"
  [ "$focus" = null ] || echo "  Window #0 Window{5e1f2a u0 $(long_form "$focus")}:"
}

dumpsys_window() {
  local focus
  focus=$(cat "$tv/focus")
  echo
  echo "WINDOW MANAGER DISPLAY CONTENTS (dumpsys window displays)"
  if [ "$focus" = null ]; then
    echo "  mCurrentFocus=null"
    echo "  mFocusedApp=null"
  else
    echo "  mCurrentFocus=Window{5e1f2a u0 $(long_form "$focus")}"
    echo "  mFocusedApp=ActivityRecord{8c3d1b u0 $(short_form "$focus") t7}"
  fi
  dumpsys_window_windows
}

# am start -W -n COMPONENT: starts the activity and reports its timing, as an API 34 emulator
# prints it. Only the activities that answer the Home intent and the exported activities besides
# Home (activities) exist on the fake TV. Started again while it has focus, an activity gets the
# intent and no timing. One of the other activities opens in a task of its own, so Home's task
# goes behind it and Home stops drawing; Home brought back from it is a hot start.
am_start() {
  local component pkg class total focus
  case "$*" in
    "-W -n "*/*) component=$3 ;;
    *) unsupported ;;
  esac
  [ $# -eq 3 ] || unsupported
  pkg=${component%%/*}
  class=${component#*/}
  echo "Starting: Intent { cmp=$component }"
  if { ! home_candidate "$component" > /dev/null && ! other_activity "$component"; } ||
    ! package_enabled "$pkg"; then
    case "$class" in .*) class=$pkg$class ;; esac
    echo "Error type 3"
    echo "Error: Activity class {$pkg/$class} does not exist."
    return 0
  fi
  total=$(cat "$tv/home-draw-ms")
  focus=$(cat "$tv/focus")
  if [ "$focus" = "$component" ]; then
    echo "Warning: Activity not started, intent has been delivered to currently running top-most instance."
    echo "Status: ok"
    echo "LaunchState: UNKNOWN (0)"
    echo "Activity: $component"
    echo "TotalTime: 0"
    echo "WaitTime: 19"
    echo "Complete"
    return 0
  fi
  echo "$component" > "$tv/focus"
  start_app "$pkg"
  if other_activity "$component"; then
    echo "Status: ok"
    if [ "$focus" = null ]; then
      echo "LaunchState: COLD"
      echo "Activity: $component"
      echo "TotalTime: 431"
      echo "WaitTime: 440"
    else
      echo "LaunchState: WARM"
      echo "Activity: $component"
      echo "TotalTime: 199"
      echo "WaitTime: 215"
    fi
  elif other_activity "$focus"; then
    echo "Warning: Activity not started, its current task has been brought to the front"
    echo "Status: ok"
    echo "LaunchState: HOT"
    echo "Activity: $component"
    echo "TotalTime: $total"
    echo "WaitTime: $((total + 29))"
  else
    echo "Status: ok"
    echo "LaunchState: COLD"
    echo "Activity: $component"
    echo "TotalTime: $total"
    echo "WaitTime: $((total + 8))"
  fi
  echo "Complete"
}

# dumpsys meminfo PACKAGE: the package's memory summary while it runs, as API 34 prints it
# (shortened). processes/<package> holds its TOTAL PSS in kB; no file means it isn't running.
dumpsys_meminfo() {
  local pss
  if [ ! -f "$tv/processes/$1" ]; then
    echo "No process found for: $1"
    return 0
  fi
  pss=$(cat "$tv/processes/$1")
  echo "Applications Memory Usage (in Kilobytes):"
  echo "Uptime: 86357 Realtime: 86357"
  echo
  echo "** MEMINFO in pid 924 [$1] **"
  echo "                   Pss  Private  Private  SwapPss      Rss     Heap     Heap     Heap"
  echo "                 Total    Dirty    Clean    Dirty    Total     Size    Alloc     Free"
  printf '        TOTAL %8s     2332     1856     6687   120076    19137    11609     2980\n' "$pss"
  echo " "
  echo " App Summary"
  echo "                       Pss(KB)                        Rss(KB)"
  echo "                        ------                         ------"
  echo "           Java Heap:      876                          35388"
  echo " "
  printf '           TOTAL PSS: %8s            TOTAL RSS:   120076       TOTAL SWAP PSS:     6687\n' "$pss"
}

# --- Settings and properties -------------------------------------------------------------

settings_get() {
  if [ -f "$tv/settings/$1/$2" ]; then cat "$tv/settings/$1/$2"; else echo null; fi
}

# settings list NAMESPACE: every set value as "key=value", sorted as the TV sorts them.
settings_list() {
  local key
  (cd "$tv/settings/$1" && LC_ALL=C ls) | while read -r key; do
    printf '%s=%s\n' "$key" "$(cat "$tv/settings/$1/$key")"
  done
}

settings_put() {
  ignored "$1/$2" || printf '%s\n' "$3" > "$tv/settings/$1/$2"
}

settings_delete() {
  if [ -f "$tv/settings/$1/$2" ]; then
    ignored "$1/$2" || rm -f "$tv/settings/$1/$2"
    echo "Deleted 1 rows"
  else
    echo "Deleted 0 rows"
  fi
}

# The kernel's memory report, as `cat /proc/meminfo` prints it (first lines only).
meminfo() {
  local total available
  read -r total available < "$tv/meminfo"
  printf '%-16s%8s kB\n' MemTotal: "$total" MemFree: $((available / 4)) MemAvailable: "$available"
}

# df -k /data, as toybox prints it: the Used column is as wide as its value.
df_data() {
  local total used available width
  read -r total used available < "$tv/storage"
  width=${#used}
  [ "$width" -lt 4 ] && width=4
  printf '%-16s %9s %*s %9s %4s %s\n' Filesystem 1K-blocks "$width" Used Available Use% "Mounted on"
  printf '%-16s %9s %*s %9s %4s %s\n' /dev/block/dm-37 "$total" "$width" "$used" "$available" \
    "$(((used * 100 + used + available - 1) / (used + available)))%" /data/user/0
}

getprop() {
  if [ $# -eq 0 ]; then
    for file in "$tv"/props/*; do echo "[${file##*/}]: [$(cat "$file")]"; done
  elif [ -f "$tv/props/$1" ]; then
    cat "$tv/props/$1"
  else
    echo
  fi
}

# --- Files under /sdcard -----------------------------------------------------------------

# Maps a TV path under /sdcard to the fake TV's copy; anything else is unsupported.
sdcard_path() {
  case "$1" in
    /sdcard | /sdcard/*) echo "$tv/sdcard${1#/sdcard}" ;;
    /storage/emulated/0 | /storage/emulated/0/*) echo "$tv/sdcard${1#/storage/emulated/0}" ;;
    *) unsupported ;;
  esac
}

# adb push [--sync] FILE... REMOTE. adb (the shell user) may make folders anywhere under /sdcard
# except in an app's own /sdcard/Android/data/<package>/, which only the app makes. --sync skips a
# file already on the TV as it is.
push() {
  local remote target folder file source sync="" bytes pushed=0 skipped=0 total=0
  if [ "${1-}" = --sync ]; then
    sync=1
    shift
  fi
  remote=${!#}
  target=$(sdcard_path "$remote") || exit $?
  for source in "${@:1:$(($# - 1))}"; do
    [ -f "$source" ] || die "adb: error: cannot stat '$source': No such file or directory"
    if [ -d "$target" ] || case "$remote" in */) true ;; *) false ;; esac; then
      folder=$target
      file="$target/${source##*/}"
    else
      folder=$(dirname "$target")
      file=$target
    fi
    if [ -n "$sync" ] && cmp -s "$source" "$file"; then
      echo "$source: 0 files pushed, 1 skipped."
      skipped=$((skipped + 1))
      continue
    fi
    bytes=$(wc -c < "$source" | tr -d ' ')
    echo "$source: 1 file pushed, 0 skipped. 0.1 MB/s ($bytes bytes in 0.001s)"
    case "$folder/" in
      "$tv/sdcard/Android/data/"*)
        [ -d "$folder" ] ||
          die "adb: error: failed to copy '$source' to '$remote': remote secure_mkdirs failed: Operation not permitted"
        ;;
    esac
    ignored "$remote" || { mkdir -p "$folder" && cp "$source" "$file"; }
    pushed=$((pushed + 1))
    total=$((total + bytes))
  done
  [ $(($# - 1)) -eq 1 ] || echo "$pushed files pushed, $skipped skipped. 0.0 MB/s ($total bytes in 0.015s)"
}

ls_path() {
  local path=""
  for arg in "$@"; do
    case "$arg" in -*) ;; *) path=$arg ;; esac
  done
  local target
  target=$(sdcard_path "$path") || exit $?
  [ -e "$target" ] || die "ls: $path: No such file or directory"
  if [ -d "$target" ]; then
    (cd "$target" && for entry in *; do [ ! -e "$entry" ] || echo "$entry"; done)
  else
    echo "$path"
  fi
}

mkdir_path() {
  local path=""
  for arg in "$@"; do
    case "$arg" in -*) ;; *) path=$arg ;; esac
  done
  local target
  target=$(sdcard_path "$path") || exit $?
  ignored "$path" || mkdir -p "$target"
}

# --- Dispatch ----------------------------------------------------------------------------

unsupported() {
  kind=unsupported
  die "fake TV: unsupported adb call: $call" 64
}

# Each call is logged once, on exit, so a call that fails part-way is still logged.
kind=unsupported
log() {
  kind=$1
}
# shellcheck disable=SC2329 # run by the EXIT trap
record() {
  inspecting || echo "$kind $call" >> "$tv/calls"
}
trap record EXIT

# Like adb, the fake reads whatever is waiting on its input, so a script that lets adb have the
# owner's input loses their answers. (The test runner gives every test an empty input.)
if ! inspecting && [ ! -t 0 ]; then
  cat > /dev/null
fi

call="$*"
serial=""
if [ "${1-}" = "-s" ]; then
  serial=${2-}
  shift 2
  call="$*"
fi
command=${1-}

# adb joins the words after "shell" into one command line for the TV's shell.
if [ "${1-}" = "shell" ]; then
  shift
  set -f
  # shellcheck disable=SC2048,SC2086 # split the joined command line into words, as the TV does
  set -- shell $*
  set +f
fi

case "$*" in
  "shell pm list packages"*) log read; need_device; shift 4; list_packages "$@" ;;
  "shell pm disable-user"*) log write; need_device; set_package_state disable-user "${!#}" disabled-user ;;
  "shell pm enable"*) log write; need_device; set_package_state enable "${!#}" enabled ;;
  "shell settings get "*) log read; need_device; settings_get "$4" "$5" ;;
  "shell settings put "*) log write; need_device; settings_put "$4" "$5" "$6" ;;
  "shell settings list "*) log read; need_device; settings_list "$4" ;;
  "shell settings delete "*) log write; need_device; settings_delete "$4" "$5" ;;
  "shell getprop"*) log read; need_device; shift 2; getprop "$@" ;;
  "shell cmd package resolve-activity"*) log read; need_device; shift 3; resolve_activity "$@" ;;
  "shell cmd role get-role-holders"*) log read; need_device; shift 4; role_holders "$@" ;;
  "shell cmd package set-home-activity"*) log write; need_device; shift 3; set_home_activity "$@" ;;
  "shell input keyevent"*) log write; need_device; keyevent "${4-}" ;;
  "shell dumpsys window") log read; need_device; dumpsys_window ;;
  "shell dumpsys window windows") log read; need_device; dumpsys_window_windows ;;
  "shell dumpsys package "*) log read; need_device; dumpsys_package "$4" ;;
  "shell dumpsys meminfo "*) log read; need_device; dumpsys_meminfo "$4" ;;
  "shell cat /proc/meminfo") log read; need_device; meminfo ;;
  "shell df -k /data") log read; need_device; df_data ;;
  # Starting an activity changes no stored state (packages, settings, the Home choice).
  "shell am start"*) log read; need_device; shift 3; am_start "$@" ;;
  "shell ls"*) log read; need_device; shift 2; ls_path "$@" ;;
  "shell mkdir"*) log write; need_device; shift 2; mkdir_path "$@" ;;
  "install "*) log write; need_device; shift; install "$@" ;;
  "uninstall "*) log write; need_device; uninstall "${2-}" ;;
  "push "*) log write; need_device; shift; push "$@" ;;
  "get-state") log read; need_device; echo device ;;
  "pair "*) log write; pair "${2-}" "${3-}" ;;
  "connect "*) log read; connect "${2-}" ;;
  "disconnect"*) log read; disconnect "${2-}" ;;
  "devices") log read; devices ;;
  "version") log read; echo "Android Debug Bridge version 1.0.41 (fake TV)" ;;
  *) unsupported ;;
esac
status=$?
if [ "$status" -eq 0 ] && [ "$kind" = write ]; then
  after_write
fi
exit "$status"
